# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — LPKS SUMBU HIDUP
# ==============================================================================
# Salin file ini menjadi .env.local untuk development lokal:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Wajib)
# Dapatkan dari Supabase Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key HANYA untuk backend/server-side (jangan bocorkan ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (Showcase / Analytics)
# Dapatkan gratis dari Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 3. APP CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
